<UserControl x:Class="WpfTodoApp.Modules.UserManagement.Views.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Main}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="用户管理" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource Brush.TextPrimary}" />
            <TextBlock Text="管理系统中的所有用户账户" FontSize="12"
                       Foreground="{StaticResource Brush.TextMuted}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Add User Form -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="用户名" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource Input.TextBox}"
                             Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="密码" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Style="{StaticResource Input.TextBox}"
                             Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <Button Grid.Column="4" Content="＋ 添加用户" MinWidth="100"
                        Style="{StaticResource Button.Primary}"
                        Command="{Binding AddUserCommand}" VerticalAlignment="Bottom"
                        Height="38" FontSize="13" />
            </Grid>
        </Border>

        <!-- Messages -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Danger}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource Brush.Success}"
                       FontSize="12" TextWrapping="Wrap" />
        </StackPanel>

        <!-- User List -->
        <ListBox Grid.Row="3" ItemsSource="{Binding Users}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                            CornerRadius="8" Padding="14,12" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <!-- Avatar -->
                                <Border Width="34" Height="34" CornerRadius="17"
                                        Background="{StaticResource Brush.PrimaryLight}"
                                        Margin="0,0,12,0">
                                    <TextBlock FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Primary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="{Binding Username, StringFormat='{}{0}'}" />
                                </Border>

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Username}" FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <Border CornerRadius="3" Padding="5,1" Margin="8,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource Brush.PrimaryLight}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAdmin}" Value="False">
                                                            <Setter Property="Background" Value="#F3F4F6" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="管理员" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAdmin}" Value="False">
                                                                <Setter Property="Text" Value="普通用户" />
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Content="重置密码" Width="76" Height="30" FontSize="12"
                                        Style="{StaticResource Button.Secondary}" Margin="0,0,6,0" />
                                <Button Content="删除" Width="54" Height="30" FontSize="12"
                                        Style="{StaticResource Button.Danger}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
