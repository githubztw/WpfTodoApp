<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Prism.DryIoc" Version="8.1.97" />
    <PackageReference Include="Serilog" Version="4.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WpfTodoApp.Core\WpfTodoApp.Core.csproj" />
    <ProjectReference Include="..\WpfTodoApp.Services\WpfTodoApp.Services.csproj" />
    <ProjectReference Include="..\WpfTodoApp.Modules.Login\WpfTodoApp.Modules.Login.csproj" />
    <ProjectReference Include="..\WpfTodoApp.Modules.UserManagement\WpfTodoApp.Modules.UserManagement.csproj" />
    <ProjectReference Include="..\WpfTodoApp.Modules.Logging\WpfTodoApp.Modules.Logging.csproj" />
    <ProjectReference Include="..\WpfTodoApp.Modules.TodoList\WpfTodoApp.Modules.TodoList.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="serilog.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.Test.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
