<UserControl x:Class="WpfTodoApp.Modules.Login.Views.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Style="{StaticResource Card}" Width="420" Padding="40">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.08" />
            </Border.Effect>
            <StackPanel>
                <!-- Icon -->
                <Border Width="56" Height="56" CornerRadius="14"
                        Background="{StaticResource Brush.Warning}" Opacity="0.15"
                        HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="!" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Warning}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="修改密码"
                           FontSize="{StaticResource FontSize.XL}" FontWeight="Bold"
                           Foreground="{StaticResource Brush.TextPrimary}"
                           HorizontalAlignment="Center" Margin="0,0,0,4" />
                <TextBlock Text="首次登录，请设置您的新密码"
                           FontSize="{StaticResource FontSize.SM}"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           HorizontalAlignment="Center" Margin="0,0,0,28" />

                <!-- Old Password -->
                <TextBlock Text="当前密码" FontSize="{StaticResource FontSize.SM}"
                           FontWeight="SemiBold" Margin="0,0,0,6" />
                <PasswordBox Style="{StaticResource Input.PasswordBox}"
                             Name="OldPasswordBox" Margin="0,0,0,14" />

                <!-- New Password -->
                <TextBlock Text="新密码" FontSize="{StaticResource FontSize.SM}"
                           FontWeight="SemiBold" Margin="0,0,0,6" />
                <PasswordBox Style="{StaticResource Input.PasswordBox}"
                             Name="NewPasswordBox" Margin="0,0,0,14" />

                <!-- Confirm Password -->
                <TextBlock Text="确认新密码" FontSize="{StaticResource FontSize.SM}"
                           FontWeight="SemiBold" Margin="0,0,0,6" />
                <PasswordBox Style="{StaticResource Input.PasswordBox}"
                             Name="ConfirmPasswordBox" Margin="0,0,0,10" />

                <!-- Password Hint -->
                <Border Background="{StaticResource Brush.PrimaryLight}"
                        CornerRadius="6" Padding="10" Margin="0,8,0,16">
                    <TextBlock Text="密码需至少6位，且包含字母和数字"
                               FontSize="{StaticResource FontSize.XS}"
                               Foreground="{StaticResource Brush.Primary}" />
                </Border>

                <!-- Error -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Danger}"
                           FontSize="{StaticResource FontSize.SM}" Margin="0,0,0,14" TextWrapping="Wrap" />

                <!-- Submit -->
                <Button Style="{StaticResource Button.Primary}"
                        Content="确认修改"
                        Command="{Binding ChangePasswordCommand}"
                        Height="44" FontSize="16" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
