<UserControl x:Class="WpfTodoApp.Modules.Login.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Main}">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border Style="{StaticResource Card}" Width="380" Padding="36,40">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.06" />
            </Border.Effect>
            <StackPanel>
                <!-- Logo -->
                <Border Width="52" Height="52" CornerRadius="13"
                        Background="{StaticResource Brush.Primary}"
                        HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="T" FontSize="22" FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="欢迎使用 TaskFlow"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource Brush.TextPrimary}"
                           HorizontalAlignment="Center" Margin="0,0,0,4" />
                <TextBlock Text="登录您的账户以继续"
                           FontSize="13"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           HorizontalAlignment="Center" Margin="0,0,0,28" />

                <!-- Username -->
                <TextBlock Text="用户名" FontSize="13" FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <TextBox Style="{StaticResource Input.TextBox}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,14" />

                <!-- Password -->
                <TextBlock Text="密码" FontSize="13" FontWeight="SemiBold"
                           Margin="0,0,0,6" />
                <PasswordBox Style="{StaticResource Input.PasswordBox}"
                             Name="PasswordBox" Margin="0,0,0,6" />

                <!-- Error -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource Brush.Danger}"
                           FontSize="12" Margin="0,4,0,18" TextWrapping="Wrap" />

                <!-- Login Button -->
                <Button Style="{StaticResource Button.Primary}"
                        Content="登 录"
                        Command="{Binding LoginCommand}"
                        Height="42" FontSize="15" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
